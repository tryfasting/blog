---
import { render } from 'astro:content';
import BlogLayout from '../blog/BlogLayout.astro';
import {
  formatDate,
  getVisiblePosts,
  isoDate,
  postIsDraft,
  postReadingMinutes,
  postSlug,
  tagUrl,
  tocItems,
  withBase,
  type Post,
} from '../blog/posts';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = tocItems(headings);
---
<BlogLayout title={post.data.title} description={post.data.description} publishedTime={post.data.date} tags={post.data.tags} wide>
  <Fragment slot="hero">
    {postIsDraft(post) && <span class="draft-label">초안</span>}
    <h1>{post.data.title}</h1>
    <p class="hero-description">{post.data.description}</p>
    <dl class="post-meta">
      <div>
        <dt>작성일</dt>
        <dd><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time></dd>
      </div>
      <div>
        <dt>읽는 시간</dt>
        <dd>약 {postReadingMinutes(post)}분</dd>
      </div>
      {post.data.tags.length > 0 && (
        <div class="post-meta-tags">
          <dt>태그</dt>
          <dd>
            <ul class="tag-list" aria-label="태그">
              {post.data.tags.map((tag) => <li><a href={tagUrl(tag)}>#{tag}</a></li>)}
            </ul>
          </dd>
        </div>
      )}
    </dl>
  </Fragment>
  <div class="post-layout">
    {toc.length > 0 && (
      <nav class="toc" aria-label="목차">
        <p class="toc-title">목차</p>
        <ol>
          {toc.map((item) => <li class:list={{ 'toc-sub': item.depth === 3 }}><a href={`#${item.slug}`}>{item.text}</a></li>)}
        </ol>
      </nav>
    )}
    <article class="post">
      <div class="prose">
        <Content />
      </div>
      <p class="back-link"><a href={withBase('/')}>← 글 목록</a></p>
    </article>
  </div>
</BlogLayout>
