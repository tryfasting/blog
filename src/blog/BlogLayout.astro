---
import 'pretendard/dist/web/variable/pretendardvariable.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource/noto-serif-kr/400.css';
import './blog.css';
import { authorName, blogFullTitle, blogSubtitle, blogTitle } from './site';
import { withBase } from './posts';

interface Props {
  title: string;
  description: string;
  /** Set on post pages to emit article metadata. */
  publishedTime?: Date;
  tags?: string[];
  /** Post pages: widen the main area so a table of contents fits beside the 680px column. */
  wide?: boolean;
}
const { title, description, publishedTime, tags = [], wide = false } = Astro.props;
// The list page tab shows the full name; other tabs put the page title first and stay short.
const pageTitle = title === blogTitle ? blogFullTitle : `${title} — ${blogTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://tryfasting.github.io');
const home = withBase('/');
const rssUrl = new URL(withBase('/rss.xml'), Astro.site ?? 'https://tryfasting.github.io');
const isList = Astro.url.pathname === home;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={authorName} />
    <meta name="theme-color" content="#f0eee6" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" type="application/rss+xml" title={blogFullTitle} href={rssUrl.href} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:type" content={publishedTime ? 'article' : 'website'} />
    <meta property="og:site_name" content={blogFullTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="ko_KR" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <div class="masthead">
      <div class="masthead-top">
      <header class="blog-header">
        <a class="blog-home" href={home}>{blogTitle}<span class="blog-subtitle"><span class="blog-subtitle-sep" aria-hidden="true"> / </span>{blogSubtitle}</span></a>
        <nav aria-label="블로그 메뉴">
          <a href={home} aria-current={isList ? 'page' : undefined}>글 목록</a>
          {/* The portfolio is a separate site on the same domain, so no base prefix. */}
          <a href="/general/">포트폴리오</a>
          <button class="search-btn" type="button" aria-label="검색" aria-controls="search-panel" aria-expanded="false" data-search-open>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" /></svg>
          </button>
        </nav>
      </header>
      <div id="search-panel" class="search-panel" role="search" hidden>
        <div class="search-inner">
          <label class="search-box">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" /></svg>
            <span class="visually-hidden">검색어</span>
            <input type="search" placeholder="글 검색" autocomplete="off" spellcheck="false" />
          </label>
          <p class="search-status" aria-live="polite"></p>
          <ol class="search-results"></ol>
        </div>
      </div>
      </div>
      {Astro.slots.has('hero') && (
        <div class="masthead-hero">
          <div class="hero"><slot name="hero" /></div>
        </div>
      )}
    </div>
    <main id="main" class:list={['blog-main', { 'blog-main--wide': wide }]}>
      <slot />
    </main>
    <footer class="blog-footer">
      <div class="blog-footer-inner">
        <nav aria-label="바깥 링크">
          <a href={rssUrl.pathname}>RSS</a>
          <a href="https://github.com/tryfasting" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </nav>
        <p>© {new Date().getFullYear()} {authorName}</p>
      </div>
    </footer>
    <script type="module" src={withBase('/search.js')} is:inline></script>
  </body>
</html>
